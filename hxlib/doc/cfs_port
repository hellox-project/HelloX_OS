19. Use mutex_condvar implement the binSemaphore, as following:
   1) Give operation:
      lock(mutex);
	  if(val < 1) {
	    val = 1;
		cond_signal(cond);  /* Signal condition variable. */
	  }
	  unlock(mutex);
   2) Take operation:
      lock(mutex);
	  while(val < 1)
	  {
	    cond_wait(cond, mutex);  /* Check the semantic of condvar. */
	  }
	  val = 0;
	  unlock(mutex);
   3) Flush operation:
      lock(mutex);
	  generation++;  /* generation counter, indicate the thread is waken up by flush or give. */
	  cond_broadcast(cond); /* Check the semantic of condvar. */
	  /* Do not change the value of val. */
	  unlock(mutex);

	  So the take's operation changes as follows:
	  lock(mutex);
	  uint32_t local_generation = generation;
	  while((val < 1) &&(local_generation == generation))
	  {
	    cond_wait(cond, mutex);
	  }
	  /* Thread is waken up now. */
	  if(local_generation != generation)
	  {
	    /* Thread is waken up by flushing, just return success. */
		unlock(mutex);
		return OS_SUCCESS;
	  }
	  /* Thread is waken up by give. */
	  val = 0;
	  unlock(mutex);
	  return OS_SUCCESS;

